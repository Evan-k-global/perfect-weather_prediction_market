{
  "name": "private-prediction-market",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsc -w -p tsconfig.json",
    "build": "tsc -p tsconfig.json",
    "fast-cache:build": "node --enable-source-maps dist/build-fast-browser-cache.js",
    "fast-node-cache:build": "node --enable-source-maps dist/build-fast-node-cache.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm typecheck",
    "bootstrap-fast-zkapp:zeko": "node --enable-source-maps dist/bootstrap-fast-zkapp-zeko.js",
    "deploy:zeko": "node --enable-source-maps dist/deploy.js",
    "sync-state:zeko": "node --enable-source-maps dist/sync-state-zeko.js",
    "create-market:zeko": "node --enable-source-maps dist/create-market-zeko.js",
    "ensure-daily-markets:zeko": "node --enable-source-maps dist/ensure-daily-markets-zeko.js",
    "resolve-weather:zeko": "node --enable-source-maps dist/resolve-weather-market-zeko.js",
    "resolve-daily-market:zeko": "node --enable-source-maps dist/resolve-daily-market-zeko.js",
    "marketplace:serve": "node --enable-source-maps dist/marketplace-server.js",
    "tx-prover:serve": "node --enable-source-maps dist/tx-prover-server.js",
    "oracle:worker": "node --enable-source-maps dist/oracle-worker.js",
    "weather:attest": "node --enable-source-maps dist/weather-attest.js",
    "weather:tls:check": "node --enable-source-maps dist/weather-tls-check.js",
    "oracle:build-statement": "node --enable-source-maps dist/resolve-from-attestation.js"
  },
  "dependencies": {
    "o1js": "^2.13.0",
    "reflect-metadata": "^0.2.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.3"
  }
}
