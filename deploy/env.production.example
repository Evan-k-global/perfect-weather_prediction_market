NODE_ENV=production

# Marketplace server
MARKETPLACE_PORT=8790
STATE_FILE=./data/operator-state.json

# Strict TLSN settings
WEATHER_REQUIRE_TLSN=1
WEATHER_TLSN_ATTESTATION_FILE=./data/tlsn-output/latest/attestation.json
WEATHER_TLSN_MAX_AGE_MS=3600000

# Daemon cadence (30m) and retry (2m)
WEATHER_DAEMON_INTERVAL_MS=1800000
WEATHER_DAEMON_RETRY_MS=120000
WEATHER_DAEMON_HEARTBEAT_FILE=./data/weather-daemon-heartbeat.json
WEATHER_DAEMON_HEALTH_MAX_AGE_MS=1200000

# TLSN runtime
TLSN_PROVER_TIMEOUT_MS=600000
TLSN_NOTARY_HOST=127.0.0.1
TLSN_NOTARY_PORT=7047
TLSN_SERVER_DOMAIN=api.weather.gov
TLSN_SERVER_HOST=api.weather.gov
TLSN_SERVER_PORT=443
TLSN_ENDPOINT=/gridpoints/MTR/86,107/forecast

# In container, mount zk-verify-poc host path to /opt/zk-verify-poc
ZKVERIFY_POC_ROOT=/opt/zk-verify-poc
